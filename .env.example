# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vitalis

# JWT
SECRET_KEY=sua-chave-secreta-muito-longa-e-aleatoria-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Redis (opcional)
REDIS_URL=redis://localhost:6379/0

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
EMAIL_FROM=noreply@vitalis.com.br

# TURN/STUN (WebRTC)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:seu-turn-server.com:3478
TURN_USER=turn_user
TURN_PASSWORD=turn_password

# Storage (S3 ou local)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
